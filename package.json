{
  "name": "photography-2026",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate-manifest": "node scripts/generate-manifest.js",
    "copy-object-storage-images": "node scripts/copy-object-storage-images.js",
    "import-gallery-db": "php scripts/import-gallery-to-db.php",
    "import-gallery-db-delta": "php scripts/import-gallery-to-db.php --delta",
    "sync-gallery-metadata": "php scripts/process-metadata-sync.php",
    "build": "ng build && call postbuild.bat",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@types/jasmine": "~5.1.0",
    "baseline-browser-mapping": "^2.10.29",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "mysql2": "^3.22.3",
    "sharp": "^0.33.5",
    "typescript": "~6.0.3"
  }
}